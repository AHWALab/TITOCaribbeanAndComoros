@startuml STREAMSat_ContainerDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title STREAM-Sat — Container Diagram (C4 Level 2)

System_Ext(imerg, "NASA GPM IMERG Early", "30-min QPE")
System_Ext(gfs, "NOAA GFS", "850 hPa U/V winds")
System_Ext(csgd, "CSGD Error Model", "Per-pixel params (.nc)")
System_Ext(tito, "TITO Orchestrator", "Downstream consumer")

System_Boundary(ss_boundary, "STREAM-Sat Real-time Pipeline") {

    Container(pipeline, "Pipeline Orchestrator", "Python 3", "run_pipeline.py — end-to-end driver.\nOrchestrates all stages in sequence.\nReads config YAML, manages scratch\nworkspace, invokes upstream STREAM-Sat.\n\nHandles: cold start, state persistence,\nwarm-up trimming, output NetCDF assembly.")

    Container(imerg_fetch, "IMERG Early Fetcher", "Python + h5py", "fetch_imerg_early.py\nDownloads latest IMERG Early half-hourly\nfiles from NASA GES DISC.\nClips to target domain, writes\nSTREAM-Sat-ready NetCDF.\nHandles V07B/V07C version transition.")

    Container(gfs_download, "GFS Wind Downloader", "Python + xarray", "download_gfs_winds.py\nDownloads GFS 0.25° U/V at 850 hPa\nfrom NOAA NOMADS for specified date range.\nRegrids to 0.1° IMERG grid.\nOutput: GFS_winds_..._0.1deg.nc")

    Container(mv_adapter, "GFS → Motion Vector Adapter", "Python + netCDF4", "gfs_to_mv_adapter.py\nConverts GFS U/V (m/s) → motion vectors\nin pixels per half-hour on IMERG grid.\nComputes speed/direction, applies\nEarth geometry corrections.\nOutput: MV_from_gfs.nc")

    Container(noise_gen, "Noise Generator", "Python + pysteps", "STREAM_NoiseGeneration.py\nGenerates ensemble of spatially correlated\nuniform noise using FFT-based anisotropic\nnon-stationary autocorrelation.\nSemi-Lagrangian advection by motion vectors.\nOutput: per-member noise NetCDF.")

    Container(precip_sim, "Precipitation Simulator", "Python + scipy", "STREAM_PrecipSimulation.py\nTransforms noise → precipitation via\nCSGD inverse-CDF at each pixel.\nApplies wetted-area ratio correction.\nOutput: per-member precip array.")

    Container(state_mgr, "State Persistence", "Python + pickle", "state_persistence.py\nSaves last 12 timesteps of noise field\nper member to .pkl (~50 MB).\nNext cycle reloads & overrides first\n12 steps → bit-identical members.")

    ContainerDb(scratch, "Scratch Workspace", "temp directory", "Per-run scratch space for intermediate\nfiles: IMERG NC, GFS NC, MV NC, noise NC.\nCleaned up after successful run.")

    ContainerDb(output, "Output Store", "NetCDF files", "Final ensemble QPE:\nSTREAMSat_<region>_<ts>_Ens50.nc\nOne file per cycle, 50 members ×\n96 half-hourly timesteps (48h).")

    ContainerDb(config_store, "Configuration", "YAML files", "config_caribbean.yaml / config_comoros.yaml\nDefines: domain, ensemble_size,\nwindow_hours, warmup_hours,\ncsgd_params, state_dir, output_dir.")
}

Rel(pipeline, imerg_fetch, "1. Fetch IMERG Early", "function call")
Rel(pipeline, gfs_download, "2. Download GFS winds", "function call")
Rel(pipeline, mv_adapter, "3. Convert GFS → motion vectors", "subprocess")
Rel(pipeline, noise_gen, "4. Generate noise (per member loop)", "library call")
Rel(pipeline, precip_sim, "5. Simulate precip (per member loop)", "library call")
Rel(pipeline, state_mgr, "6. Save state (last 12 steps)", "library call")
Rel(pipeline, config_store, "Reads config at startup", "YAML parse")

Rel(imerg_fetch, imerg, "HTTPS download", "GES DISC")
Rel(gfs_download, gfs, "HTTPS download", "NOMADS")
Rel(mv_adapter, imerg_fetch, "Reads IMERG grid geometry", "file read")
Rel(mv_adapter, gfs_download, "Reads GFS U/V winds", "file read")
Rel(noise_gen, mv_adapter, "Reads motion vectors", "NetCDF read")
Rel(precip_sim, imerg_fetch, "Reads IMERG observations", "NetCDF read")
Rel(precip_sim, csgd, "Reads error model params", "NetCDF read")
Rel(state_mgr, noise_gen, "Saves tail of noise field", "pickle dump")

Rel(pipeline, scratch, "Creates temp workspace", "file I/O")
Rel(pipeline, output, "Writes final ensemble NetCDF", "file I/O")
Rel(output, tito, "Consumed by TITO Orchestrator\n→ converted to GeoTIFFs", "file read")

@enduml
