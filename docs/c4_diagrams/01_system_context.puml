@startuml TITO_SystemContext
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title TITO — System Context Diagram (C4 Level 1)

' ── People ──────────────────────────────────────────────────────────────
Person(forecaster, "Operational Forecaster", "Monitors flash-flood alerts & forecast outputs")
Person(hydrologist, "Hydrologist / Researcher", "Runs hindcast experiments, analyses ensemble outputs")
Person(sysadmin, "System Administrator", "Manages cron schedules, monitors pipeline health")

' ── External Systems ────────────────────────────────────────────────────
System_Boundary(precip_boundary, "Precipitation & Ensemble Sources") {
    System_Ext(nasa_gpm, "NASA GPM IMERG", "Satellite QPE — 30-min, 0.1°\nIMERG Early V07 (4h latency)")
    System_Ext(noaa_gfs, "NOAA GFS", "Global NWP — QPF forecasts\n")
    System_Ext(meteofrance_arome, "Météo-France AROME", "Regional NWP — high-res QPF\nANTIL & INDIEN domains")
    System_Ext(noaa_scampr, "NOAA SCaMPR", "IR-based gap-fill QPE\nNear-real-time (≤30 min latency)")
    System_Ext(hsaf, "H-SAF (EUMETSAT)", "H40B QPE — 10-min\n(for Comoros)")
    System_Ext(stream_sat, "STREAM-Sat Engine", "CSGD error model + anisotropic noise.\nGenerates 50-member precipitation ensembles\nfrom IMERG Early + GFS wind fields.")
}

' ── TITO System ─────────────────────────────────────────────────────────
System_Boundary(tito_boundary, "TITO — Threading Inputs to Outputs") {
    System(tito_system, "TITO Orchestrator", "Real-time & hindcast EF5 hydrologic modelling.\nIntegrates satellite QPE + QPF\n→ ensemble flash-flood forecasts across 5 regions.")
}

' ── Downstream ──────────────────────────────────────────────────────────
System_Ext(ef5_model, "EF5 Hydro Model", "CREST + Kinematic Wave\nDistributed hydrologic model\n(binary, called as subprocess)")

' ── Relationships ───────────────────────────────────────────────────────
Rel(forecaster, tito_system, "Reviews flood alerts & QPF outputs", "email/dashboard")
Rel(hydrologist, tito_system, "Configures & triggers hindcasts", "CLI / config.py")
Rel(sysadmin, tito_system, "Manages cron + monitors logs", "SSH / cron")

Rel(tito_system, nasa_gpm, "Downloads IMERG Early QPE", "HTTPS (GPM server)")
Rel(tito_system, noaa_gfs, "Downloads GFS QPF + wind fields", "HTTPS (NOMADS)")
Rel(tito_system, meteofrance_arome, "Downloads AROME QPF", "HTTPS/FTP")
Rel(tito_system, noaa_scampr, "Downloads SCaMPR gap-fill QPE", "HTTPS (AWS S3)")
Rel(tito_system, hsaf, "Downloads H40B QPE (optional)", "FTP (H-SAF)")
' ── STREAM-Sat pushes ensemble output to orchestrator ────────────────────
Rel(stream_sat, tito_system, "Pushes 50-member ensemble GeoTIFFs\n→ Orchestrator builds per-member EF5 jobs\n→ runs in parallel for all 5 regions", "File store")

Lay_R(tito_system, ef5_model)
Rel(tito_system, ef5_model, "Generates control files per member × region × QPF source,\ninvokes EF5 binary in parallel", "subprocess call")

@enduml
