@startuml TITO_DeploymentDiagram
!include <C4/C4_Deploy>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title TITO — Deployment Diagram

' ── External Cloud Services ─────────────────────────────────────────────
Deployment_Node(aws_cloud, "AWS / Internet Services") {
    Deployment_Node(s3_scampr, "AWS S3 — NOAA SCaMPR") {
        Container(scampr_data, "SCaMPR RRQPE-INST-GLB", "GeoTIFF", "Global IR QPE, public bucket")
    }
    Deployment_Node(gpm_server, "NASA GPM Server") {
        Container(imerg_data, "IMERG Early V07", "HDF5 → GeoTIFF", "30-min, 0.1°, 4h latency")
    }
    Deployment_Node(nomads, "NOAA NOMADS") {
        Container(gfs_data, "GFS 0.25° Forecasts", "GRIB2", "Hourly QPF + 850 hPa winds")
    }
    Deployment_Node(mf_ftp, "Meteo-France FTP") {
        Container(arome_data, "AROME QPF", "NetCDF", "ANTIL & INDIEN domains")
    }
}

' ── Compute Node ────────────────────────────────────────────────────────
Deployment_Node(compute_node, "Linux Compute Server", "Ubuntu 22.04 LTS") {

    Deployment_Node(conda_env, "Conda Environment (tito_env2)", "Python 3.10") {

        ' ── TITO Application ────────────────────────────────────────────
        Container(tito_app, "TITO Application", "Python", "orchestrator.py + tito_utils/")

        ' ── STREAM-Sat ─────────────────────────────────────────────────
        Container(ss_app, "STREAM-Sat Pipeline", "Python", "STREAM_Main.py + extension/")

        ' ── EF5 Binary ──────────────────────────────────────────────────
        Container(ef5_bin, "EF5 v1.2.7", "C++ Binary", "CREST + Kinematic Wave")
    }

    ' ── Cron ────────────────────────────────────────────────────────────
    Deployment_Node(cron_node, "Cron Scheduler") {
        Container(cron_daemon, "cron", "bash", "pipeline.sh @ HH:07 UTC")
        Container(cron_mgr, "manage_cron.sh", "bash", "Configures cron with 7-min offset\nfor data arrival window")
    }

    ' ── Local Storage ───────────────────────────────────────────────────
    Deployment_Node(file_system, "Local File System", "XFS / ext4") {

        Deployment_Node(basic_dir, "basic/") {
            Container(dem, "DEM", "GeoTIFF")
            Container(fac, "FAC", "GeoTIFF")
            Container(fdir, "FDIR", "GeoTIFF")
        }

        Deployment_Node(params_dir, "parameters/") {
            Container(crest_params, "CREST params", "GeoTIFF")
            Container(kw_params, "KW params", "GeoTIFF")
        }

        Deployment_Node(precip_dirs, "precip/ + precipEF5/") {
            Container(imerg_tifs, "IMERG .tif", "GeoTIFF")
            Container(scampr_tifs, "SCaMPR .tif", "GeoTIFF")
            Container(ss_tifs, "STREAM-Sat .tif", "GeoTIFF")
        }

        Deployment_Node(qpf_dir, "qpf_store/") {
            Container(gfs_qpf, "GFS QPF", "GeoTIFF")
            Container(arome_qpf, "AROME QPF", "GeoTIFF")
        }

        Deployment_Node(states_dir, "states/") {
            Container(imerg_states, "IMERG states", "GeoTIFF")
            Container(ss_states, "STREAM-Sat states", "GeoTIFF")
        }

        Deployment_Node(outputs_dir, "outputs/") {
            Container(ef5_outputs, "EF5 outputs", "GeoTIFF + CSV")
            Container(logs, "Run logs", "text")
            Container(ss_outputs, "STREAM-Sat outputs", "GeoTIFF + CSV")
        }

        Deployment_Node(templates_dir, "templates/") {
            Container(ctrl_templates, "EF5 control templates", ".txt")
            Container(basin_lists, "Basin definitions", ".txt")
        }
    }
}

' ── External Email ──────────────────────────────────────────────────────
Deployment_Node(email_infra, "Email Infrastructure") {
    Container(smtp_svr, "SMTP Server", "TLS :587", "Alert delivery service")
}

' ── Relationships ───────────────────────────────────────────────────────
' Internet data flows
Rel(tito_app, imerg_data, "HTTPS download\nIMERG Early", "443/tcp")
Rel(tito_app, scampr_data, "HTTPS download\nSCaMPR IR QPE", "443/tcp")
Rel(tito_app, gfs_data, "HTTPS download\nGFS QPF + winds", "443/tcp")
Rel(tito_app, arome_data, "FTP download\nAROME QPF", "21/tcp")
Rel(ss_app, gfs_data, "HTTPS download\nGFS 850 hPa winds", "443/tcp")

' Cron → app
Rel(cron_daemon, tito_app, "triggers hourly", "bash pipeline.sh")
Rel(cron_mgr, cron_daemon, "configures schedule", "crontab")

' App → local storage
Rel(tito_app, dem, "reads", "file")
Rel(tito_app, fac, "reads", "file")
Rel(tito_app, fdir, "reads", "file")
Rel(tito_app, crest_params, "reads", "file")
Rel(tito_app, kw_params, "reads", "file")
Rel(tito_app, ctrl_templates, "reads + generates", "file")
Rel(tito_app, basin_lists, "reads", "file")

' App writes
Rel(tito_app, imerg_tifs, "writes downloaded QPE", "file")
Rel(tito_app, scampr_tifs, "writes downloaded QPE", "file")
Rel(ss_app, ss_tifs, "writes ensemble GeoTIFFs", "file")
Rel(tito_app, gfs_qpf, "writes staged QPF", "file")
Rel(tito_app, arome_qpf, "writes staged QPF", "file")
Rel(tito_app, imerg_states, "writes model states", "file")
Rel(tito_app, ss_states, "writes ensemble states", "file")
Rel(tito_app, ef5_outputs, "writes simulation results", "file")
Rel(tito_app, logs, "writes pipeline logs", "file")
Rel(ss_app, ss_outputs, "writes ensemble outputs", "file")

' EF5 binary invocation
Rel(tito_app, ef5_bin, "invokes via subprocess", "process")

' Alert delivery
Rel(tito_app, smtp_svr, "sends alert emails", "587/tcp")

@enduml
