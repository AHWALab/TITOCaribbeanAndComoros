# Copy to tito_credentials.env (git-ignored) and restrict it:
#   cp tito_credentials.env.example tito_credentials.env && chmod 600 tito_credentials.env
# tito-run.sh loads it; variables already exported in the environment win.
# On AWS, set the same variables from Secrets Manager instead.

# NASA PPS account email (PPS uses it as username AND password).
# Used by TITO IMERG downloads and by STREAM-Sat.
TITO_GPM_EMAIL=

# HSAF FTP account (only needed where HSAF is used: Comoros gap-fill).
TITO_HSAF_FTP_USER=
TITO_HSAF_FTP_PASS=

# SMTP account for e-mail alerts (only when SEND_ALERTS = True).
#TITO_SMTP_SERVER=smtp.gmail.com
#TITO_SMTP_PORT=587
#TITO_SMTP_USER=
#TITO_SMTP_PASSWORD=
