# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Large binary ML/model files
*.h5
*.hdf5
*.pth
*.npy
*.nc
*.nc4
*.grb
*.grib
*.grib2

# Temporary files
*.tmp
*.log
temp/

# Raster/binary data files — never commit these (except basic/ and parameters/)
*.tif
*.tiff
*.aux.xml
!basic/*.tif
!basic/*.tiff
!parameters/**/*.tif
!parameters/**/*.tiff

# Runtime data folders (precip downloads, EF5 staging, model states, outputs)
# These are populated at run-time and can be very large.
precip/
precipEF5/
qpf_store/
states/
outputs/
