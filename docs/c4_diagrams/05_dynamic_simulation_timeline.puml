@startuml TITO_Dynamic_SimulationTimeline
!include <C4/C4_Dynamic>

LAYOUT_TOP_DOWN()

title TITO — Dynamic Diagram: Single-Cycle Simulation Timeline

' ── Actors & Containers ─────────────────────────────────────────────────
Person(forecaster, "Forecaster", "")
Container(cron, "Cron Scheduler", "cron", "Triggers pipeline.sh every hour at HH:07")
Container(orchestrator, "TITO Orchestrator", "Python", "Master workflow engine")
Container(precip_pipeline, "Precipitation Pipeline", "Python", "Downloads forcing data")
Container(stream_sat, "STREAM-Sat Engine", "Python", "Ensemble QPE generation")
Container(ef5_builder, "EF5 Job Builder", "Python", "Generates control files")
Container(ef5_executor, "EF5 Executor", "Python", "Runs EF5 simulations")
Container(state_store, "State Store", "Files", "Model state files")
Container(output_store, "Output Store", "Files", "Simulation outputs")
Container(email_svr, "SMTP Server", "SMTP", "Alert delivery")

' ── Timeline: Nowcast Mode (STREAM-Sat + SCaMPR + QPF) ─────────────────

' 1. Cron Trigger
Rel(cron, orchestrator, "HH:07 — triggers pipeline.sh", "bash")

' 2. Configuration Loading
Rel_Back(orchestrator, orchestrator, "Load config, normalize regions,\ndetermine cycle time T = now rounded to hour", "importlib")

' 3. STEP 1: Precipitation Download (parallel per source)
Rel(orchestrator, precip_pipeline, "STEP 1: Download & prepare all precip", "prepare_all_precip()")

Rel(precip_pipeline, precip_pipeline, "IMERG Early → T-4h window\nSCaMPR → T-30m gap fill\nGFS QPF → T+24h forecast\nAROME QPF → T+24h forecast", "parallel downloads")

' 4. STREAM-Sat Trigger (if STREAM_SAT mode)
Rel(orchestrator, stream_sat, "STEP 2a: Trigger STREAM-Sat ensemble", "subprocess")
Rel(stream_sat, stream_sat, "1. Download IMERG Early (T-X to T-4h)\n2. Download GFS 850 hPa winds\n3. Generate noise ensemble (N members)\n4. Simulate precip ensemble\n5. Convert NetCDF → GeoTIFFs per member", "pipeline stages")

' 5. STEP 2: Region Config & Directory Setup
Rel(orchestrator, orchestrator, "STEP 2b: Build region_configs,\ncreate per-region directories", "loop per region")

' 6. STEP 3-4: QPF Staging
Rel(orchestrator, orchestrator, "STEP 3-4: Stage QPF files\nto per-region qpf_store/", "file copy")

' 7. STEP 5: Build EF5 Jobs
Rel(orchestrator, ef5_builder, "STEP 5: Build EF5 control files", "prepare_ef5()")
Rel(ef5_builder, state_store, "Search for prior states\n(7-day lookback)", "file scan")

' 7a. Cold Start Path (no states found)
alt #fdebd0 No states found (cold start / first run)
    Rel(ef5_builder, ef5_builder, "Cold-start logic:\nSet simulation start = T-6h,\nwarm_end = T-4h (6h warmup period)", "internal")
    Rel(ef5_builder, orchestrator, "Send cold-start alert email", "SMTP alert")
else States found (warm start)
    Rel(ef5_builder, ef5_builder, "Warm-start: resume from\nmost recent state timestamp", "internal")
end

' 7b. STREAM-Sat Phase A: QPE-only runs
Rel(ef5_builder, ef5_builder, "Phase A (per member N=1..50):\nSTREAM-Sat QPE only,\nsave state at window end", "loop per member")

' 7c. STREAM-Sat Phase B: Gap-fill + QPF
Rel(ef5_builder, ef5_builder, "Phase B (per member, per QPF):\nSCaMPR gap-fill T-4h→T,\nGFS/AROME QPF T→T+24h", "loop per member x QPF")

' 7d. IMERG EF5 job
Rel(ef5_builder, ef5_builder, "IMERG-only run:\nQPE T-10h→T-4h,\nsave state at T-4h", "1 job per region")

' 7e. LR (QPF) EF5 jobs
Rel(ef5_builder, ef5_builder, "SCaMPR+QPF run:\nStart from IMERG state,\nSCaMPR T-4h→T,\nQPF T→T+24h", "1 job per QPF source")

' 8. Execute All EF5 Runs (parallel)
Rel(orchestrator, ef5_executor, "STEP 5: Execute all EF5 jobs", "ThreadPoolExecutor")
Rel(ef5_executor, ef5_executor, "Parallel execution across:\n· Regions (5)\n· Ensemble members (50)\n· QPF sources (GFS, AROME)\n· Job types (SS-A, SS-B, IMERG, LR)", "multi-threaded")

Rel(ef5_executor, state_store, "Write model states:\ncrest_SM, kwr_IR, kwr_pCQ, kwr_pOQ\nat cycle end times", "EF5 binary")
Rel(ef5_executor, output_store, "Write outputs:\nmaxq, maxunitq, qpeaccum, qpfaccum,\nmaxsm, maxdepth, timeseries CSV", "EF5 binary")

' 9. Alerts
Rel(orchestrator, email_svr, "STEP 6: Send alerts if\nthresholds exceeded", "SMTP")

' 10. Cleanup
Rel(orchestrator, orchestrator, "Cleanup: staged precip files,\nqpf_store data, stale caches", "finally block")

' ── Cycle Complete ──────────────────────────────────────────────────────
Rel(orchestrator, cron, "Cycle complete.\nNext run at HH+1:07.", "exit(0)")

@enduml
