@startuml STREAMSat_Dynamic_Cycles
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml

LAYOUT_TOP_DOWN()

title STREAM-Sat — Dynamic Diagram: First vs Subsequent Cycles

Container(pipeline, "Pipeline Orchestrator", "Python", "run_pipeline.py")
Container(imerg, "IMERG Fetcher", "Python", "fetch_imerg_early.py")
Container(gfs_dl, "GFS Downloader", "Python", "download_gfs_winds.py")
Container(mv, "GFS→MV Adapter", "Python", "gfs_to_mv_adapter.py")
Container(noise, "Noise Generator", "Python", "STREAM_NoiseGeneration.py")
Container(precip, "Precip Simulator", "Python", "STREAM_PrecipSimulation.py")
Container(state, "State Manager", "pickle", "state_persistence.py")
ContainerDb(output, "Output Store", "NetCDF", "STREAMSat_*_Ens50.nc")

' ═══════════════════════════════════════════════════════════════════════════
' FIRST CYCLE (Cold Start)
' ═══════════════════════════════════════════════════════════════════════════

group #FFE0B2 FIRST CYCLE — Cold Start (state dir empty, output dir empty)

    Rel(pipeline, imerg, "Fetch 60h IMERG Early\n(48h window + 12h warmup)", "HTTPS")
    Rel(pipeline, gfs_dl, "Download GFS 850 hPa winds\nfor matching 60h window", "HTTPS")
    Rel(pipeline, mv, "Convert GFS U/V → motion vectors\n0.1°, half-hourly", "subprocess")

    loop 50 ensemble members (~3-4 min total)
        Rel(pipeline, noise, "Generate noise for 60h\n(120 half-hourly steps)\nseed = 1000 + member_id", "library call")

        note right #FFB6C1
            **No saved state found → cold start**
            Noise initialized from t=0
            → AR(1) chain spins up from scratch
        end note

        Rel(pipeline, precip, "Apply CSGD error model\nIMERG + noise → precip ensemble\n(120 half-hourly steps)", "library call")
    end

    Rel(pipeline, pipeline, "[trim] Drop first 24 steps (12h)\nas AR(1) warm-up buffer", "internal")

    Rel(pipeline, state, "[state] Save last 12 timesteps\n× 50 members → state.pkl (~50 MB)", "pickle dump")

    Rel(pipeline, output, "[output] Write 96 new timesteps\n0 skipped → STREAMSat_*_Ens50.nc", "NetCDF write")

end

' ═══════════════════════════════════════════════════════════════════════════
' SUBSEQUENT CYCLES (+30 min)
' ═══════════════════════════════════════════════════════════════════════════

group #E0FFE0 SUBSEQUENT CYCLE — Warm Start (+30 min later)

    Rel(pipeline, imerg, "Fetch 60h IMERG Early\n(window shifted +30 min)", "HTTPS")
    Rel(pipeline, gfs_dl, "Download GFS winds\n(shifted +30 min)", "HTTPS")
    Rel(pipeline, mv, "Convert GFS → motion vectors", "subprocess")

    Rel(pipeline, state, "[state] Load state.pkl from\nprevious cycle (0.5h ago)\n12 timesteps × 50 members", "pickle load")

    loop 50 ensemble members (~3-4 min total)
        Rel(pipeline, noise, "Generate noise for 60h", "library call")

        note right #ADD8E6
            **State override:** first 12 noise
            timesteps replaced with saved state
            → member k at clock time t is
            **bit-identical** to previous cycle
        end note

        Rel(pipeline, precip, "Apply CSGD error model", "library call")
    end

    Rel(pipeline, pipeline, "[trim] Drop first 24 steps (12h)\nas AR(1) warm-up buffer", "internal")

    Rel(pipeline, state, "[state] Save last 12 timesteps\n× 50 members → state.pkl (~50 MB)", "pickle dump")

    Rel(pipeline, output, "[output] Write 1 new timestep\n95 skipped (already exist)\n→ STREAMSat_*_Ens50.nc", "NetCDF write")

end

' ═══════════════════════════════════════════════════════════════════════════
' SUMMARY
' ═══════════════════════════════════════════════════════════════════════════

note bottom of output #E8EAF6
  **Key Differences — First vs Subsequent Cycles**
  
  |                 | First Cycle (Cold Start)      | Subsequent Cycles (+30 min)      |
  | Ingest window   | 60h (48h + 12h warmup)        | 60h (shifted +30 min)            |
  | State on entry  | None — cold start              | Loaded from previous .pkl        |
  | Noise init      | From t=0 (AR(1) spin-up)      | First 12 steps overridden by state|
  | Member identity | New random seed                | Bit-identical to previous cycle  |
  | Output written  | 96 new timesteps               | 1 new, 95 skipped                |
  | State saved     | 12 timesteps × 50 members      | 12 timesteps × 50 members        |
  | Run time        | ~3-4 minutes                   | ~3-4 minutes                     |
  
  **The 12h AR(1) warm-up buffer is ALWAYS trimmed** from output.
  It exists only to let the noise autoregressive chain reach steady state.
  The output window is always **48h backward-looking** (T−48h → T), NOT a forecast.
end note

@enduml
