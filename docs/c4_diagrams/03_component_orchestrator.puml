@startuml TITO_ComponentDiagram
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title TITO Orchestrator — Component Diagram (C4 Level 3)

' ── External Containers ─────────────────────────────────────────────────
Container(precip_pipeline, "Precipitation Pipeline", "Python", "Download & stage forcing data")
Container(stream_sat, "STREAM-Sat Engine", "Python", "Ensemble QPE generation")
Container(ef5_binary, "EF5 Binary", "C++", "Hydrologic model executable")
ContainerDb(precip_store, "Precipitation Store", "GeoTIFF", "Staged forcing files")
ContainerDb(state_store, "State Store", "GeoTIFF", "Model state files")
ContainerDb(output_store, "Output Store", "GeoTIFF + CSV", "Simulation outputs")

' ── Orchestrator Boundary ───────────────────────────────────────────────
Container_Boundary(orchestrator_boundary, "TITO Orchestrator (orchestrator.py)") {

    ' ── Main Entry Point ────────────────────────────────────────────────
    Component(main_ctl, "Main Controller", "main()", "Entry point. Parses CLI args,\nloads config, determines cycle time.\nDispatches to Nowcast or Hindcast loop.")

    ' ── Cycle Manager ───────────────────────────────────────────────────
    Component(cycle_mgr, "Cycle Manager", "_run_single_cycle()", "Orchestrates one hourly cycle:\nStep 1 → precip download\nStep 2 → region configs\nStep 3 → directory creation\nStep 4 → QPF staging\nStep 5 → EF5 execution\nStep 6 → cleanup & summary")

    ' ── Precipitation Coordinator ───────────────────────────────────────
    Component(precip_coord, "Precipitation Coordinator", "prepare_all_precip()", "Central precip dispatch.\nGroups regions by QPE/QPF source,\ndownloads shared forcing once.\nReturns SharedPrecip dataclass.")

    ' ── Region Config Builder ───────────────────────────────────────────
    Component(region_cfg, "Region Config Builder", "per-region loop", "Builds region_configs dict:\ntimeline offsets, state paths,\nQPE/QPF per region,\ntemplate selection,\nIMERG latency compensation.")

    ' ── STREAM-Sat Ensemble Builder ─────────────────────────────────────
    Component(ss_builder, "STREAM-Sat Job Builder", "_build_streamsat_ensemble_jobs()", "Two-phase ensemble workflow.\nPhase A: STREAM-Sat QPE only\n→ save states at window end.\nPhase B: SCaMPR gap fill +\nGFS/AROME QPF forecast.\nPer-member state isolation.")

    ' ── IMERG Job Builder ───────────────────────────────────────────────
    Component(imerg_builder, "IMERG Job Builder", "_build_imerg_ef5_job()", "Builds IMERG-only EF5 jobs.\nCold-start logic: 6h warmup\nif no prior states found.\nSaves states at T-4h\n(IMERG latency boundary).")

    ' ── LR Job Builder ──────────────────────────────────────────────────
    Component(lr_builder, "LR (QPF) Job Builder", "_build_lr_ef5_jobs()", "Builds SCaMPR+QPF EF5 jobs.\nStarts from IMERG state at T-4h,\ngap-fills to T with SCaMPR,\nforecasts to T+24h with\nGFS / AROME QPF.")

    ' ── EF5 Execution Engine ────────────────────────────────────────────
    Component(ef5_exec, "EF5 Execution Engine", "run_ef5_simulations_parallel()", "ThreadPool-based parallel EF5 runner.\nExecutes all prepared jobs\n(IMERG + LR + STREAM-Sat phases).\nHandles exit codes, renames\noutputs with timestamps.")

    ' ── State Manager Component ─────────────────────────────────────────
    Component(state_comp, "State Lifecycle Manager", "find_available_states() + alerts", "7-day backward search for\nviable model states.\nCold-start detection & alert.\nPer-member state isolation\nfor STREAM-Sat ensembles.")

    ' ── Config Loader ───────────────────────────────────────────────────
    Component(config_loader, "Config Loader", "importlib + normalization", "Dynamically imports config module.\nValidates QPE/QPF sources.\nNormalizes per-region\nforcing overrides.")

    ' ── Cleanup Service ─────────────────────────────────────────────────
    Component(cleanup_svc, "Cleanup Service", "finally block", "Post-cycle cleanup:\nstaged precipEF5 files,\nregional qpf_store data,\nstale shared caches.")

    ' ── Logging & Summary ───────────────────────────────────────────────
    Component(logging_svc, "Logging & Summary", "setup_run_log() + console", "Master pipeline log per cycle.\nPer-job EF5 run logs.\nRich console progress display.\nSimulation summary table.")
}

' ── Internal Relationships ──────────────────────────────────────────────
Rel(main_ctl, cycle_mgr, "Dispatches per cycle", "function call")
Rel(main_ctl, config_loader, "Loads config", "importlib")

Rel(cycle_mgr, precip_coord, "STEP 1: Download precipitation", "function call")
Rel(cycle_mgr, region_cfg, "STEP 2: Build region configs", "loop per region")
Rel(cycle_mgr, ss_builder, "STEP 5a: Build STREAM-Sat jobs", "conditional on STREAM_SAT")
Rel(cycle_mgr, imerg_builder, "STEP 5b: Build IMERG jobs", "conditional on non-STREAM_SAT")
Rel(cycle_mgr, lr_builder, "STEP 5c: Build LR QPF jobs", "conditional on LR_run")
Rel(cycle_mgr, ef5_exec, "STEP 5: Execute all EF5 jobs", "function call")
Rel(cycle_mgr, cleanup_svc, "STEP 6: Post-cycle cleanup", "finally block")
Rel(cycle_mgr, logging_svc, "Logs all progress", "function call")

Rel(precip_coord, precip_pipeline, "Delegates to shared downloaders", "Library call")
Rel(ss_builder, stream_sat, "Triggers STREAM-Sat pipeline", "subprocess")
Rel(ss_builder, state_comp, "Creates per-member state dirs", "mkdir")
Rel(imerg_builder, state_comp, "Checks for prior states", "function call")
Rel(lr_builder, state_comp, "Locates IMERG state for chain", "function call")
Rel(ef5_exec, ef5_binary, "Invokes EF5 binary", "subprocess")
Rel(ef5_exec, state_store, "Writes states at cycle end", "EF5 internal")
Rel(ef5_exec, output_store, "Writes simulation outputs", "EF5 internal")

Rel(region_cfg, precip_store, "Resolves precip paths", "path reference")
Rel(imerg_builder, precip_store, "Stages IMERG → precipEF5", "file copy")
Rel(lr_builder, precip_store, "Stages SCaMPR → precipEF5", "file copy")

@enduml
