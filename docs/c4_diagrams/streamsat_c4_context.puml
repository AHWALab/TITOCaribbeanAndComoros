@startuml STREAMSat_SystemContext
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title STREAM-Sat — System Context Diagram (C4 Level 1)

Person(operator, "Pipeline Operator", "Triggers real-time ensemble generation\nor configures hindcast runs")

System_Boundary(ss_boundary, "STREAM-Sat — Ensemble Precipitation Engine") {
    System(stream_sat, "STREAM-Sat Pipeline", "Generates 50-member precipitation\nensembles at half-hourly resolution.\n48h backward-looking QPE window\nwith 12h AR(1) warm-up buffer.")
}

System_Ext(imerg, "NASA GPM IMERG Early", "Satellite QPE — 30-min, 0.1°\n~4h latency (GES DISC)")
System_Ext(gfs, "NOAA GFS", "Global NWP — 850 hPa U/V winds\n0.25°, hourly (NOMADS)")
System_Ext(csgd, "CSGD Error Model", "Pre-trained per-pixel error\ndistributions (GPM DPR reference)\nMust match target domain grid.")
System_Ext(tito, "TITO Orchestrator", "Consumes STREAM-Sat ensemble\nNetCDFs → converts to GeoTIFFs\n→ builds per-member EF5 jobs")

Rel(operator, stream_sat, "Runs pipeline with config YAML", "CLI")
Rel(stream_sat, imerg, "Fetches latest IMERG Early Run\n(48h + 12h warmup = 60h window)", "HTTPS (GES DISC)")
Rel(stream_sat, gfs, "Downloads GFS 850 hPa U/V winds", "HTTPS (NOMADS)")
Rel(stream_sat, csgd, "Reads CSGD error parameters", "NetCDF file")
Rel(stream_sat, tito, "Writes ensemble NetCDF\n(50 members × 96 half-hourly steps)", "File system")

@enduml
