@startuml TITO_SystemLandscape
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title WMO Caribbean & Comoros — System Landscape

' ═══════════════════════════════════════════════════════════════════════════
' DATA ACQUISITION LAYER
' ═══════════════════════════════════════════════════════════════════════════
System_Ext(imerg, "IMERG Early V07", "NASA GPM — 30-min, 0.1° satellite QPE, 4h latency")
System_Ext(scampr, "SCaMPR", "NOAA — IR-based gap-fill QPE, ≤30 min latency")
System_Ext(hsaf, "H-SAF H40B", "EUMETSAT — 10-min satellite QPE")
System_Ext(gfs, "GFS", "NOAA — Global NWP, QPF + 850 hPa winds")
System_Ext(arome, "AROME", "Meteo-France — High-res regional NWP (ANTIL/INDIEN)")
System_Ext(merra2, "MERRA2", "NASA — Atmospheric reanalysis wind fields")

' ═══════════════════════════════════════════════════════════════════════════
' ENSEMBLE GENERATION LAYER
' ═══════════════════════════════════════════════════════════════════════════
System_Boundary(ensemble_layer, "Ensemble Precipitation Generation") {
    System(stream_sat_sys, "STREAM-Sat", "CSGD error model + anisotropic noise.\nGenerates N-member QPE ensembles\nconditioned on IMERG + wind fields.")
    System(rainyday_sys, "RainyDay Tools", "NetCDF → GeoTIFF batch conversion.\nExtracts ensemble members as\nindividual GeoTIFF stacks.")
    System(csgd_model, "CSGD Error Model", "Pre-trained per-pixel error\ndistributions (GPM DPR reference).")
}

' ═══════════════════════════════════════════════════════════════════════════
' OPERATIONAL FORECASTING LAYER (TITO)
' ═══════════════════════════════════════════════════════════════════════════
System_Boundary(tito_layer, "TITO — Operational Hydrologic Forecasting") {
    System(tito_sys, "TITO Orchestrator", "Master workflow engine.\nHourly cycles: download → EF5 jobs →\nsimulate → save states → alerts.\nModes: Nowcast, Hindcast, Ensemble.")
    System(ef5_sys, "EF5 Hydro Model", "CREST + Kinematic Wave.\nDistributed hydrologic simulation.\nRunoff, soil moisture, flood forecasting.")
}

' ═══════════════════════════════════════════════════════════════════════════
' REGIONAL DEPLOYMENTS
' ═══════════════════════════════════════════════════════════════════════════
System_Boundary(regions_layer, "Regional Domains (90m resolution)") {
    System(antigua_sys, "Antigua & Barbuda", "EF5 domain — 90m")
    System(barbados_sys, "Barbados", "EF5 domain — 90m")
    System(guatemala_sys, "Guatemala", "EF5 domain — 90m")
    System(haiti_sys, "Haiti", "EF5 domain — 90m")
    System(comoros_sys, "Comoros", "EF5 domain — 90m")
}

' ═══════════════════════════════════════════════════════════════════════════
' DOWNSTREAM / CONSUMERS
' ═══════════════════════════════════════════════════════════════════════════
Person(forecaster, "Operational Forecaster", "Receives flash-flood alerts")
Person(hydrologist, "Hydrologist / Researcher", "Hindcast analysis, ensemble evaluation")
System_Ext(alerts, "Email Alert System", "SMTP-based flood warning delivery")

' ═══════════════════════════════════════════════════════════════════════════
' SUPPORTING TOOLS
' ═══════════════════════════════════════════════════════════════════════════
System(ef5_builder_tk, "EF5 Builder Toolkit", "GIS pre-processing.\nGenerates DEM, FAC, FDIR,\nCREST & KW parameter layers.")
System(nowcast_ml, "ML Nowcast System", "ConvLSTM-based precipitation\nnowcasting (servir_nowcasting).")
System(ens_tools, "Ensemble Tools", "Ensemble setup, execution,\nand visualization scripts.\n(oneYearWarmUp, ensembleEstimates)")

' ═══════════════════════════════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════════════════════════════

' Data → Ensemble
Rel(imerg, stream_sat_sys, "IMERG Early QPE input", "NetCDF")
Rel(gfs, stream_sat_sys, "GFS 850 hPa wind → motion vectors", "NetCDF")
Rel(merra2, stream_sat_sys, "MERRA2 U850/V850 (offline)", "NetCDF")
Rel(csgd_model, stream_sat_sys, "Error model parameters", "NetCDF")
Rel(stream_sat_sys, rainyday_sys, "Ensemble NetCDF", "NetCDF → GeoTIFF")

' Data → TITO
Rel(imerg, tito_sys, "IMERG Early QPE (T-X to T-4h)", "GeoTIFF")
Rel(scampr, tito_sys, "SCaMPR gap-fill (T-4h to T)", "GeoTIFF")
Rel(hsaf, tito_sys, "H40B QPE (alternative)", "GeoTIFF")
Rel(gfs, tito_sys, "GFS QPF (T to T+24h)", "GeoTIFF")
Rel(arome, tito_sys, "AROME QPF (T to T+24h)", "GeoTIFF")
Rel(rainyday_sys, tito_sys, "STREAM-Sat ensemble GeoTIFFs", "GeoTIFF (ensP1..ensPN)")

' TITO → EF5
Rel(tito_sys, ef5_sys, "Generates control files, invokes binary", "subprocess")

' EF5 → Regions
Rel(ef5_sys, antigua_sys, "Simulates Antigua", "EF5 domain run")
Rel(ef5_sys, barbados_sys, "Simulates Barbados", "EF5 domain run")
Rel(ef5_sys, guatemala_sys, "Simulates Guatemala", "EF5 domain run")
Rel(ef5_sys, haiti_sys, "Simulates Haiti", "EF5 domain run")
Rel(ef5_sys, comoros_sys, "Simulates Comoros", "EF5 domain run")

' Alerts
Rel(tito_sys, alerts, "Sends threshold-based alerts", "SMTP")
Rel(alerts, forecaster, "Delivers flood warnings", "email")

' Human interactions
Rel(hydrologist, tito_sys, "Configures & runs hindcasts", "CLI + config.py")
Rel(hydrologist, ens_tools, "Runs ensemble experiments", "Python scripts")

' Supporting tools
Rel(ef5_builder_tk, ef5_sys, "Generates input layers", "GeoTIFF files")
Rel(nowcast_ml, tito_sys, "Provides ML nowcast (optional)", "Python library")

@enduml
